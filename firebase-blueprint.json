{
  "entities": {
    "Animal": {
      "collection": "animals",
      "fields": {
        "id": {
          "type": "string",
          "description": "Cow identification ID like COW-027"
        },
        "rfidTag": {
          "type": "string",
          "description": "Electronic RFID ear tag ID"
        },
        "name": { "type": "string", "description": "Animal name" },
        "species": { "type": "string", "description": "Species" },
        "breed": { "type": "string", "description": "Breed e.g. HF Crossbred" },
        "ageYears": { "type": "number", "description": "Age in years" },
        "parity": { "type": "number", "description": "Lactation cycle number" },
        "lactationStage": {
          "type": "string",
          "description": "early, mid, late, dry"
        },
        "priorMastitisCount": {
          "type": "number",
          "description": "Previous mastitis episodes"
        },
        "currentRisk": {
          "type": "string",
          "description": "normal, suspected, risked"
        },
        "currentRiskScore": {
          "type": "number",
          "description": "Composite risk percentage"
        },
        "scc": { "type": "number", "description": "Somatic Cell Count per ml" },
        "ec": {
          "type": "number",
          "description": "Electrical conductivity in mS/cm"
        },
        "ph": { "type": "number", "description": "Milk pH" },
        "milkTemp": {
          "type": "number",
          "description": "Milk temperature in Celsius"
        },
        "wearable": {
          "type": "object",
          "description": "Stage 2 Wearable telemetry",
          "fields": {
            "ruminationMinutes": { "type": "number" },
            "activityStatus": { "type": "string" },
            "bodyTemp": { "type": "number" }
          }
        },
        "assignedBarn": {
          "type": "string",
          "description": "Assigned housing barn e.g. Barn A"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      }
    },
    "Screening": {
      "collection": "screenings",
      "fields": {
        "id": { "type": "string" },
        "animalId": { "type": "string" },
        "scc": { "type": "number" },
        "ec": { "type": "number" },
        "ph": { "type": "number" },
        "milkTemp": { "type": "number" },
        "timestamp": { "type": "string" },
        "riskLevel": { "type": "string" }
      }
    },
    "Alert": {
      "collection": "alerts",
      "fields": {
        "id": { "type": "string" },
        "animalId": { "type": "string" },
        "severity": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "BarnZone": {
      "collection": "barnZones",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tempC": { "type": "number", "description": "Ambient temperature" },
        "humidityPct": { "type": "number" },
        "thi": {
          "type": "number",
          "description": "Temperature Humidity Index"
        },
        "season": { "type": "string" }
      }
    }
  }
}
